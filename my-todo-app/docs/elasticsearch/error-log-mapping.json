{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "error_message_analyzer": {
          "type": "standard",
          "stopwords": "_none_"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "timestamp": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd'T'HH:mm:ss.SSSZ||epoch_millis"
      },
      "level": {
        "type": "keyword"
      },
      "loggerName": {
        "type": "keyword"
      },
      "serviceName": {
        "type": "keyword"
      },
      "traceId": {
        "type": "keyword"
      },
      "spanId": {
        "type": "keyword"
      },
      "message": {
        "type": "text",
        "analyzer": "error_message_analyzer"
      },
      "stackTrace": {
        "type": "text",
        "index": true
      },
      "exceptionClass": {
        "type": "keyword"
      },
      "tenantId": {
        "type": "long"
      },
      "userId": {
        "type": "long"
      },
      "requestPath": {
        "type": "keyword"
      },
      "requestMethod": {
        "type": "keyword"
      },
      "statusCode": {
        "type": "integer"
      },
      "tags": {
        "type": "keyword"
      }
    }
  }
}
